  <previewCommands>setup repeat 75 [ go ]</previewCommands>
  <experiments>
    <experiment name="Fig5-haut" repetitions="1" sequentialRunOrder="true" runMetricsEveryStep="false" timeLimit="1">
      <setup>setup</setup>
      <metrics>
        <metric>kstar-stable</metric>
        <metric>kstar-unstable</metric>
        <metric>num-roots</metric>
      </metrics>
      <constants>
        <enumeratedValueSet variable="R-slider">
          <value value="1"></value>
        </enumeratedValueSet>
        <enumeratedValueSet variable="T-slider">
          <value value="0.2"></value>
          <value value="0.4"></value>
          <value value="0.6"></value>
          <value value="0.8"></value>
        </enumeratedValueSet>
        <enumeratedValueSet variable="c-d-slider">
          <value value="0.2"></value>
          <value value="0.5"></value>
          <value value="0.8"></value>
        </enumeratedValueSet>
        <steppedValueSet variable="c-h-slider" first="0" step="0.02" last="1"></steppedValueSet>
      </constants>
    </experiment>
    <experiment name="Fig5-bas" repetitions="1" sequentialRunOrder="true" runMetricsEveryStep="false" timeLimit="1">
