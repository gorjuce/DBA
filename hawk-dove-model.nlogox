<?xml version="1.0" encoding="utf-8"?>
<model version="NetLogo 7.0.4" snapToGrid="true">
  <code><![CDATA[;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;; Reproduction de la Figure 5 de Chen et al. (2017)
;; N-person Hawk-Dove Game with Threshold (HDG-T), population finie.
;;
;; PRINCIPE : la Figure 5 trace k*/Z, la position des EQUILIBRES
;; INTERIEURS (ni tout-hawk ni tout-dove). Un equilibre est un
;; nombre k de doves ou dove et hawk ont la meme fitness moyenne,
;; c.-a-d. ou gap(k) = fitness-dove(k) - fitness-hawk(k) change de
;; signe. On NE SIMULE PAS : on calcule directement ces racines.
;; Donc AUCUNE tortue n'est necessaire.
;;
;;   gap passe de + a -  => equilibre STABLE   (point plein Fig.5)
;;   gap passe de - a +  => equilibre INSTABLE (point vide  Fig.5)
;;
;; Parametres fixes de la Figure 5 : Z = 100, N = 5, R = 1.
;;
;; Le modele contient deux parties independantes :
;;   1. setup  : calcul analytique des equilibres (aucun agent) ;
;;   2. setup-sim + go : simulation de la dynamique d'imitation.
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

globals [
  Z            ;; taille de la population finie (100)
  N            ;; taille du groupe d'interaction / echantillon (5)
  R            ;; ressource (1)
  T            ;; seuil (copie de T-slider)
  c-h          ;; cout des hawks (copie de c-h-slider)
  c-d          ;; cout des doves (copie de c-d-slider)
  logfact      ;; table : logfact[n] = ln(n!), pour les coeff. binomiaux
  roots-cache  ;; racines interieures, calculees une seule fois au setup
  n-doves      ;; nombre courant de doves (mis a jour chaque tour)
]

turtles-own [
  strategie          ;; "dove" ou "hawk"
  nouvelle-strategie ;; strategie decidee ce tick (imitation synchrone), appliquee apres
  ressources         ;; stock cumule des payoffs (suivi uniquement : sans effet sur la dynamique)
]

;; ---- Setup : prepare les parametres. NE cree AUCUNE tortue. ----
to setup
  clear-all
  set Z 100
  set N 5
  set R R-slider
  set T T-slider
  set c-h c-h-slider
  set c-d c-d-slider
  build-logfact
  set roots-cache interior-roots   ;; calcul unique par run
  print (word "R=" R " -> " roots-cache)
  reset-ticks
end

;; ---- Table des log-factorielles : logfact[n] = ln(n!) ----
to build-logfact
  set logfact (list 0)             ;; logfact[0] = ln(0!) = 0
  let idx 1
  while [ idx <= Z ] [
    set logfact lput ((item (idx - 1) logfact) + ln idx) logfact
    set idx idx + 1
  ]
end

;; ln du coefficient binomial C(n, m) ; vaut -infini si le coeff. est 0
to-report log-choose [nn mm]
  if (mm < 0) or (mm > nn) or (nn < 0) [ report -1e300 ]
  report (item nn logfact) - (item mm logfact) - (item (nn - mm) logfact)
end

;; ---- Fitness moyenne d'un HAWK s'il y a k doves dans la population ----
;; Echantillonnage hypergeometrique (Chen Eq. 15) + payoff HDG-T (Eq. 5).
;; Le hawk focal regarde ses N-1 partenaires ; i = nb de doves parmi eux.
to-report fitness-hawk [k]
  let total 0
  let i 0
  while [ i <= N - 1 ] [
    let lw (log-choose k i)
          + (log-choose (Z - k - 1) (N - 1 - i))
          - (log-choose (Z - 1) (N - 1))
    if lw > -700 [
      let nd i                     ;; doves dans le groupe (focal est hawk)
      let nh N - nd                ;; hawks dans le groupe (focal inclus)
      let payoff 0
      ;; si les doves n'atteignent PAS le seuil, les hawks se battent
      if (nd / N) < T [ set payoff (R - (nh - 1) * c-h) / nh ]
      set total total + (exp lw) * payoff
    ]
    set i i + 1
  ]
  report total
end

;; ---- Fitness moyenne d'un DOVE s'il y a k doves dans la population ----
;; Echantillonnage hypergeometrique (Chen Eq. 16) + payoff HDG-T (Eq. 6).
to-report fitness-dove [k]
  let total 0
  let i 0
  while [ i <= N - 1 ] [
    let lw (log-choose (k - 1) i)
          + (log-choose (Z - k) (N - 1 - i))
          - (log-choose (Z - 1) (N - 1))
    if lw > -700 [
      let nd i + 1                 ;; doves dans le groupe (focal inclus)
      let nh N - nd                ;; hawks dans le groupe
      let payoff 0
      ;; si les doves atteignent le seuil, ils expulsent les hawks et partagent
      if (nd / N) >= T [ set payoff (R - nh * c-d) / nd ]
      set total total + (exp lw) * payoff
    ]
    set i i + 1
  ]
  report total
end

;; ecart de fitness dove - hawk pour k doves
to-report gap [k]
  report (fitness-dove k) - (fitness-hawk k)
end

;; ---- Racines interieures : les k ou gap change de signe ----
;; Chaque racine est une liste [ k/Z  stable? ].
to-report interior-roots
  let result []
  let previous gap 1
  let k 2
  while [ k <= Z - 1 ] [
    let current gap k
    if (previous = 0) or ((previous < 0) != (current < 0)) [
      let is-stable (previous > 0 and current < 0)
      set result lput (list (k / Z) is-stable) result
    ]
    set previous current
    set k k + 1
  ]
  report result
end

;; ---- Sorties simples, a tabuler dans BehaviorSpace ----

;; k*/Z de la premiere racine STABLE (point plein), ou "" s'il n'y en a pas
to-report kstar-stable
  foreach roots-cache [ root -> if item 1 root [ report item 0 root ] ]
  report ""
end

;; k*/Z de la premiere racine INSTABLE (point vide), ou "" s'il n'y en a pas
to-report kstar-unstable
  foreach roots-cache [ root -> if not item 1 root [ report item 0 root ] ]
  report ""
end

;; nombre total de racines interieures
to-report num-roots
  report length roots-cache
end

;;report fitness max
to-report max-fitness
  let max-dove max map fitness-dove (n-values Z [ i -> i ])
  let max-hawk max map fitness-hawk (n-values Z [ i -> i ])
  report max (list max-dove max-hawk)
end

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;; DYNAMIQUE D'IMITATION
;;
;; Population fixe de Z agents, chacun dove ou hawk. A chaque tick :
;;   1. on calcule le payoff moyen espere de chaque strategie dans la
;;      composition actuelle (fitness-dove, fitness-hawk) ;
;;   2. chaque agent tire un autre agent au hasard et copie sa
;;      strategie avec une probabilite de Fermi (beta = 1) ;
;;      mise a jour synchrone ;
;;   3. le payoff est ajoute au stock "ressources" (suivi seulement).
;; La simulation s'arrete a la fixation (tous doves ou tous hawks).
;; Il n'y a ni mutation ni mort/renaissance (ancienne extension
;; "burn-rate" laissee en commentaire dans go).
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

;; ---- Setup de la SIMULATION (cree les agents) ----
to setup-sim
  clear-all
  set Z 100
  set N N-slider
  set R R-slider
  set T T-slider
  set c-h c-h-slider
  set c-d c-d-slider
  build-logfact
  set roots-cache interior-roots   ;; cible analytique gardee sous la main
  create-turtles Z [
    set strategie ifelse-value (random-float 1 < initial-prop-dove-slider) [ "dove" ] [ "hawk" ]
    set nouvelle-strategie strategie
    set ressources 50 + random-float 20
    setxy random-xcor random-ycor
    update-color
  ]
  set n-doves count turtles with [ strategie = "dove" ]
  reset-ticks
end


to go
  set n-doves count turtles with [ strategie = "dove" ]

  let pi-dove fitness-dove n-doves
  let pi-hawk fitness-hawk n-doves

  ; strategy update (imitation, regle de Fermi avec beta = 1)
  ask turtles [
    let other-agent one-of other turtles
    if other-agent != nobody [
      let pi-moi ifelse-value (strategie = "dove") [ pi-dove ] [ pi-hawk ]
      let pi-lui ifelse-value ([strategie] of other-agent = "dove") [ pi-dove ] [ pi-hawk ]
      let p-copy 1 / (1 + exp (- 1 * (pi-lui - pi-moi)))
      
      if random-float 1 < p-copy [ set nouvelle-strategie [strategie] of other-agent ]
    ]
  ]
  ask turtles [ set strategie nouvelle-strategie ]

  ; payoff
  ask turtles [
    ifelse strategie = "dove"
      [ set ressources ressources + pi-dove ]
    [ set ressources ressources + pi-hawk ]

    ; if ressources <= 0 [ die ]
  ]
  

  ; renew
  ; let manquants Z - count turtles
  ; create-turtles manquants [
  ;   set strategie [strategie] of one-of other turtles
  ;   set ressources 50 + random-float 20
  ;   setxy random-xcor random-ycor
  ;   update-color
  ; ]
  
  set n-doves count turtles with [ strategie = "dove" ]
  
  ; if count turtles = 0 [ stop ]
  if hawk-fixation? or dove-fixation? [ stop ]
  tick
end

to update-color
  ifelse strategie = "dove" [set color blue] [set color red]
end


;; ---- Reporters de suivi (pour graphiques / monitors) ----

;; ecart de fitness maximal (utile pour calibrer beta, actuellement fixe a 1)
to-report delta-pi-max
  report max map [ k -> abs (gap k) ] (n-values (Z - 1) [ i -> i + 1 ])
end

to-report prop-dove
  report n-doves / Z
end

to-report prop-hawk
  report (Z - n-doves) / Z
end

to-report ressources-moyennes
  report mean [ ressources ] of turtles
end

to-report hawk-fixation?
  report any? turtles
    and all? turtles [strategie = "hawk"]
end


to-report dove-fixation?
  report any? turtles
    and all? turtles [strategie = "dove"]
end
]]></code>
